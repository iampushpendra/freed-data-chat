# FREED Data Chat — VM query API environment
#
# Copy to /etc/freed/chat-query.env, fill in real values, chmod 600, and
# point the systemd unit's EnvironmentFile= at it. query_api.py reads these
# from the process environment only — it does not parse this file itself.

# --- Postgres connection (chat_ro, read-only role) ---
PG_HOST=172.20.12.9
PG_PORT=5432
PG_DB=freed_app_db
PG_USER=chat_ro
PG_PASSWORD=changeme

# --- Auth ---
# Bearer secret the Vercel /api/chat function must send as
# `Authorization: Bearer <QUERY_API_SECRET>`. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QUERY_API_SECRET=changeme

# --- Limits ---
ROW_CAP=2000
STATEMENT_TIMEOUT=60s

# --- Network ---
BIND_HOST=127.0.0.1
BIND_PORT=8158

# --- Audit log ---
AUDIT_LOG=/home/ubuntu/freed-data-chat/chat-query.log
